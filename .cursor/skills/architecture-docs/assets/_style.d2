vars: {
  d2-config: {
    layout-engine: tala
    pad: 32
    theme-overrides: {
      N7: "#faf9f5"
    }
  }
}

classes: {
  person: {shape: person; width: 64; height: 64; style: {fill: "#e0e3d7"; stroke: "#788c5d"; font-color: "#141413"}}
  core: {width: 230; height: 64; style: {fill: "#f3dfd5"; stroke: "#d97757"; stroke-width: 2; border-radius: 8; font-color: "#141413"; bold: true}}
  module: {width: 230; height: 64; style: {fill: "#ffffff"; stroke: "#8a887f"; border-radius: 8; font-color: "#141413"; bold: false}}
  external: {width: 230; height: 64; style: {fill: "#dde6ed"; stroke: "#6a9bcc"; font-color: "#141413"; bold: false}}
  store: {shape: cylinder; width: 180; height: 72; style: {fill: "#e8e6dc"; stroke: "#8a887f"; font-color: "#141413"; bold: false}}
  stage: {label.near: bottom-center; style: {fill: "#f0eee6"; stroke: "#f0eee6"; border-radius: 12; font-color: "#5e5d59"; bold: true; font-size: 18}}
  phase: {style: {fill: "#f0eee6"; stroke: "#e8e6dc"; border-radius: 8; font-color: "#5e5d59"; bold: true}}
  boundary: {style: {fill: "#faf9f5"; stroke: "#b0aea5"; stroke-dash: 4; border-radius: 16; font-color: "#5e5d59"; font-size: 16}}
  frame: {label: ""; style: {fill: transparent; stroke: transparent}}
  spacer: {label: ""; width: 230; height: 64; style: {fill: transparent; stroke: transparent}}
  primary: {style: {stroke: "#d97757"; stroke-width: 3; font-color: "#141413"; font-size: 15}}
  flow: {style: {stroke: "#8a887f"; stroke-width: 2; font-color: "#5e5d59"; font-size: 15}}
  aside: {style: {stroke: "#8a887f"; stroke-width: 2; stroke-dash: 3; font-color: "#5e5d59"; font-size: 15}}
}
