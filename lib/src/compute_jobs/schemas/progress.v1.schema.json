{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "progress.json, major version 1",
  "description": "A job's latest progress, written by compute_jobs.progress.report. schema is v0's version field; schema_version, added in v0.1, has the same value, and readers prefer it.",
  "type": "object",
  "required": ["schema", "updated_at"],
  "properties": {
    "schema": { "const": 1 },
    "schema_version": { "const": 1 },
    "phase": { "type": "string" },
    "step": { "type": "integer", "minimum": 0 },
    "step_name": { "type": "string" },
    "steps_total": { "type": "integer", "minimum": 0 },
    "done": { "type": "integer", "minimum": 0 },
    "total": { "type": "integer", "minimum": 0 },
    "failed": { "type": "integer", "minimum": 0 },
    "best": {
      "type": "object",
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string" },
        "value": { "type": "number" },
        "higher_is_better": { "type": "boolean" }
      }
    },
    "message": { "type": "string" },
    "updated_at": {
      "description": "An RFC 3339 time, such as 2026-10-15T03:26:00Z.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
