{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListArchive",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket"],
      "Resource": "arn:aws:s3:::<bucket>"
    },
    {
      "Sid": "ReadArchive",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::<bucket>/*"
    }
  ]
}
