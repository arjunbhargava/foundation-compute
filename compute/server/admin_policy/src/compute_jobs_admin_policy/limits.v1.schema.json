{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "limits.yaml, major version 1",
  "description": "The compute list: hardware profiles of ordered EC2 instance types, the EC2 vCPU quotas, and the daily spending cap. Every field is required, so a misspelt field can't silently enable an instance type.",
  "type": "object",
  "required": ["schema_version", "daily_cap_usd", "quotas", "profiles"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "daily_cap_usd": { "type": "number", "exclusiveMinimum": 0 },
    "quotas": {
      "description": "Each quota group's EC2 vCPU quota in us-east-1.",
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "required": ["max_runtime_minutes", "entries"],
      "additionalProperties": false,
      "properties": {
        "max_runtime_minutes": { "type": "integer", "minimum": 1 },
        "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } }
      }
    },
    "entry": {
      "type": "object",
      "required": [
        "instance_type",
        "quota",
        "spot_quota",
        "accelerator",
        "gpus_per_node",
        "gpu_memory_gb",
        "vcpus",
        "usd_per_hour",
        "max_nodes",
        "spot_allowed",
        "enabled"
      ],
      "additionalProperties": false,
      "properties": {
        "instance_type": { "type": "string", "minLength": 1 },
        "quota": { "type": "string", "minLength": 1 },
        "spot_quota": { "type": ["string", "null"], "minLength": 1 },
        "accelerator": { "type": ["string", "null"], "minLength": 1 },
        "gpus_per_node": { "type": "integer", "minimum": 0 },
        "gpu_memory_gb": { "type": ["integer", "null"], "minimum": 1 },
        "vcpus": { "type": "integer", "minimum": 1 },
        "usd_per_hour": { "type": "number", "exclusiveMinimum": 0 },
        "max_nodes": { "type": "integer", "minimum": 1 },
        "spot_allowed": { "type": "boolean" },
        "enabled": { "type": "boolean" }
      },
      "allOf": [
        {
          "description": "A CPU type has no accelerator or GPU memory, and a GPU type has both.",
          "if": { "properties": { "gpus_per_node": { "const": 0 } } },
          "then": { "properties": { "accelerator": { "type": "null" }, "gpu_memory_gb": { "type": "null" } } },
          "else": { "properties": { "accelerator": { "type": "string" }, "gpu_memory_gb": { "type": "integer" } } }
        },
        {
          "description": "spot_quota names a quota group exactly when spot is allowed.",
          "if": { "properties": { "spot_allowed": { "const": true } } },
          "then": { "properties": { "spot_quota": { "type": "string" } } },
          "else": { "properties": { "spot_quota": { "type": "null" } } }
        }
      ]
    }
  }
}
